# Supabase / public anon configuration only — never put service_role keys here.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Academic Demo Mode — skip login and use the header "View App As" role switcher.
# Set to false to restore normal Supabase email/password authentication.
NEXT_PUBLIC_DEMO_MODE=true
